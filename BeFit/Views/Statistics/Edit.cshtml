@model BeFit.Models.Exercise

@{
    ViewData["Title"] = "Edytuj ćwiczenie";
}

<h1>Edytuj ćwiczenie</h1>

<h4>Ćwiczenie</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" class="form-control" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NumOfSeries" class="control-label"></label>
                <input asp-for="NumOfSeries" class="form-control" />
                <span asp-validation-for="NumOfSeries" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NumOfReps" class="control-label"></label>
                <input asp-for="NumOfReps" class="form-control" />
                <span asp-validation-for="NumOfReps" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ExerciseTypeId" class="control-label"></label>
                <select asp-for="ExerciseTypeId" class="form-control" asp-items="ViewBag.ExerciseTypeId">
                    <option value="">-- wybierz typ ćwiczenia --</option>
                </select>
                <span asp-validation-for="ExerciseTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SessionId" class="control-label"></label>
                <select asp-for="SessionId" class="form-control" asp-items="ViewBag.SessionId">
                    <option value="">-- wybierz sesję treningową --</option>
                </select>
                <span asp-validation-for="SessionId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Zapisz" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Powrót do listy</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}